# Local Docker engines only. Copy to .env (gitignored) and change the values.
# These are placeholders, not credentials for any real environment.

# SQL Server container (docker-compose.yml, service "sql").
# Must satisfy SQL Server complexity rules (upper, lower, digit, symbol, 8+ chars).
# appsettings.json uses the same placeholder; if you change it here, override
# ConnectionStrings__ClearPay as well (see README "Installation").
MSSQL_SA_PASSWORD=ChangeMe_LocalDev_1!

# RabbitMQ container defaults (local only).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
