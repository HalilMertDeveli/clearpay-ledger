<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Separate service: notifications + nightly reconciliation. Own database (ClearPayOps, schema "ops"),
    talks to the ledger host only through RabbitMQ events and the PSP settlement drop folder.
    It must not reference ClearPay.Infrastructure (enforced by ArchitectureTests).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3f0c9b1e-6a52-4d8e-9a77-0c1d2e3f4a5b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.17" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.17" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.21">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pins for patched versions of vulnerable transitive dependencies (same as the ledger host). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClearPay.Application\ClearPay.Application.csproj" />
    <ProjectReference Include="..\ClearPay.Messaging\ClearPay.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Sql\*.sql" />
  </ItemGroup>

</Project>
